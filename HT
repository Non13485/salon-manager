const C='salon-v1',F=['./','./index.html','./manifest.webmanifest','./icon-192.png','./icon-512.png'];self.addEventListener('install',e=>e.waitUntil(caches.open(C).then(c=>c.addAll(F))));self.addEventListener('fetch',e=>{if(e.request.method==='GET')e.respondWith(caches.match(e.request).then(x=>x||fetch(e.request).catch(()=>caches.match('./index.html'))))});
<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#17243a"><link rel="manifest" href="manifest.webmanifest"><link rel="apple-touch-icon" href="icon-192.png"><title>Salon Manager</title>
<style>
:root{--n:#17243a;--g:#c7a56a;--bg:#f3f5f8;--line:#e4e8ee}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:#202b3b;font:15px -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;padding-bottom:30px}header{background:var(--n);color:white;padding:20px 16px;position:sticky;top:0;z-index:3}header small{letter-spacing:1.5px;color:#d7dce4}header h1{margin:5px 0 0;font-size:23px}nav{display:flex;gap:7px;overflow:auto;background:white;padding:10px;position:sticky;top:76px;z-index:2}button{border:0;border-radius:10px;padding:11px 14px;font-weight:650;background:var(--n);color:white}nav button{white-space:nowrap;background:#eef1f5;color:#29364a}nav button.on{background:var(--n);color:white}main{max-width:760px;margin:auto;padding:13px}.page{display:none}.page.on{display:block}.card,.entry,.stat{background:white;border:1px solid var(--line);border-radius:14px;padding:14px;margin-bottom:11px}.stats{display:grid;grid-template-columns:repeat(2,1fr);gap:9px}.stat span{font-size:12px;color:#697586}.stat b{display:block;font-size:22px;margin-top:5px}label{display:block;font-size:13px;font-weight:650;margin:11px 0 5px}input,textarea{width:100%;border:1px solid #d5dce5;border-radius:9px;padding:11px;font:inherit;background:white}textarea{min-height:65px}.muted{font-size:13px;color:#697586}.row{display:flex;gap:10px;align-items:center}.photo{width:64px;height:64px;object-fit:cover;border-radius:10px;background:#eef1f5}.actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:10px}.soft{background:#edf0f4;color:#29364a}.red{background:#b42318}.gold{background:var(--g);color:#182235}.pill{font-size:11px;background:#f4efe5;color:#70552b;border-radius:20px;padding:4px 8px}.empty{text-align:center;padding:22px;color:#697586}.hint{font-size:12px;line-height:1.5;color:#697586}
</style></head><body><header><small>CUSTOMER & SERVICE MANAGEMENT</small><h1>✂ SALON MANAGER</h1></header>
<nav><button class="on" data-p="home">Tổng quan</button><button data-p="list">Khách hàng</button><button data-p="form">Thêm khách</button><button data-p="backup">Sao lưu</button></nav><main>
<section id="home" class="page on"><div class="stats"><div class="stat"><span>Khách hàng</span><b id="nCust">0</b></div><div class="stat"><span>Lượt dịch vụ</span><b id="nServ">0</b></div><div class="stat"><span>Doanh thu đã ghi</span><b id="nRev">0đ</b></div><div class="stat"><span>Lịch hẹn tới</span><b id="nVisit">0</b></div></div><div class="card"><h3>Salon Manager</h3><p class="muted">Quản lý hồ sơ, tình trạng tóc, công thức hóa chất, dịch vụ, ảnh và lịch hẹn khách hàng.</p><button onclick="go('form')">＋ Thêm khách hàng</button></div><div class="card"><h3>Lịch chăm sóc sắp tới</h3><div id="upcoming" class="muted">Chưa có lịch hẹn.</div></div></section>
<section id="list" class="page"><div class="card"><input id="search" placeholder="Tìm tên hoặc số điện thoại..." oninput="renderList()"></div><div id="customers"></div></section>
<section id="form" class="page"><div class="card"><h3 id="formHeading">Thêm hồ sơ khách hàng</h3><input type="hidden" id="cid"><label>Họ tên *</label><input id="name" placeholder="Tên khách hàng"><label>Số điện thoại</label><input id="phone" type="tel"><label>Ảnh khách hàng</label><input id="portrait" type="file" accept="image/*"><label>Tình trạng tóc</label><textarea id="hair" placeholder="Tóc yếu, khô, đã tẩy, nền tóc..."></textarea><label>Lưu ý đặc biệt</label><textarea id="caution"></textarea><hr><h3>Ghi nhận dịch vụ</h3><label>Dịch vụ</label><input id="service" placeholder="Nhuộm, uốn, duỗi, phục hồi..."><label>Sản phẩm / mã hóa chất</label><input id="product"><label>Công thức / tỷ lệ pha</label><textarea id="formula"></textarea><label>Thời gian xử lý</label><input id="timing" placeholder="Ví dụ 35 phút"><label>Giá dịch vụ (VNĐ)</label><input id="price" type="number" min="0"><label>Ngày hẹn quay lại</label><input id="visit" type="date"><label>Ảnh trước / sau</label><input id="workphotos" type="file" accept="image/*" multiple><label>Ghi chú lần làm</label><textarea id="note"></textarea><div class="actions"><button onclick="save()">Lưu hồ sơ</button><button class="soft" onclick="clearForm()">Làm mới</button></div><p class="hint">Ảnh được nén để giảm dung lượng. Hãy sao lưu định kỳ và không xóa dữ liệu trình duyệt khi chưa có bản sao.</p></div></section>
<section id="backup" class="page"><div class="card"><h3>Sao lưu và khôi phục</h3><p class="muted">Xuất tệp JSON rồi tải tệp đó lên Google Drive bằng ứng dụng Drive. Khi cần, tải tệp từ Drive về và khôi phục tại đây.</p><div class="actions"><button onclick="backup()">Tải bản sao lưu</button><button class="soft" onclick="document.getElementById('restore').click()">Khôi phục từ tệp</button><input id="restore" type="file" accept=".json,application/json" hidden onchange="restoreData(event)"></div><hr><b>Vị trí lưu:</b> <span class="pill">Bộ nhớ trình duyệt trên thiết bị</span><p class="hint">Bản phát hành này chưa tự động sao lưu nền lên Google Drive. Tệp JSON cần được tải lên Drive thủ công.</p></div></section>
</main><script>
const DB='salon_manager_final_db',STORE='customers';let db;
function openDB(){return new Promise((ok,no)=>{let r=indexedDB.open(DB,1);r.onupgradeneeded=()=>r.result.createObjectStore(STORE,{keyPath:'id'});r.onsuccess=()=>{db=r.result;ok()};r.onerror=()=>no(r.error)})}
function all(){return new Promise((ok,no)=>{let r=db.transaction(STORE).objectStore(STORE).getAll();r.onsuccess=()=>ok(r.result);r.onerror=()=>no(r.error)})}
function put(x){return new Promise((ok,no)=>{let r=db.transaction(STORE,'readwrite').objectStore(STORE).put(x);r.onsuccess=()=>ok();r.onerror=()=>no(r.error)})}
function go(p){document.querySelectorAll('.page').forEach(x=>x.classList.toggle('on',x.id===p));document.querySelectorAll('nav button').forEach(x=>x.classList.toggle('on',x.dataset.p===p));if(p==='list')renderList()}
document.querySelectorAll('nav button').forEach(x=>x.onclick=()=>go(x.dataset.p));
function v(id){return document.getElementById(id).value}function esc(s){return String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function compress(f){return new Promise(ok=>{if(!f)return ok('');let r=new FileReader();r.onload=()=>{let im=new Image();im.onload=()=>{let c=document.createElement('canvas'),k=Math.min(1,1000/Math.max(im.width,im.height));c.width=im.width*k;c.height=im.height*k;c.getContext('2d').drawImage(im,0,0,c.width,c.height);ok(c.toDataURL('image/jpeg',.72))};im.src=r.result};r.readAsDataURL(f)})}
async function save(){if(!v('name').trim())return alert('Vui lòng nhập họ tên.');let arr=await all(),id=v('cid')||'KH'+Date.now(),old=arr.find(x=>x.id===id)||{},portraitFile=document.getElementById('portrait').files[0],portrait=portraitFile?await compress(portraitFile):old.portrait||'',files=[...document.getElementById('workphotos').files],photos=files.length?await Promise.all(files.map(compress)):[];let hist=old.history||[];if(v('service')||v('formula')||v('price'))hist.unshift({date:new Date().toISOString().slice(0,10),service:v('service'),product:v('product'),formula:v('formula'),timing:v('timing'),price:+v('price')||0,visit:v('visit'),note:v('note'),photos});await put({...old,id,name:v('name').trim(),phone:v('phone'),hair:v('hair'),caution:v('caution'),portrait,history:hist});alert('Đã lưu hồ sơ.');clearForm();go('list');home()}
function clearForm(){['cid','name','phone','hair','caution','service','product','formula','timing','price','visit','note','portrait','workphotos'].forEach(x=>document.getElementById(x).value='');document.getElementById('formHeading').textContent='Thêm hồ sơ khách hàng'}
async function renderList(){let q=v('search').toLowerCase(),a=(await all()).filter(x=>(x.name+' '+x.phone).toLowerCase().includes(q)).sort((x,y)=>x.name.localeCompare(y.name,'vi')),el=document.getElementById('customers');el.innerHTML=a.length?'':'<div class="empty">Chưa có khách hàng.</div>';a.forEach(c=>{let d=document.createElement('div');d.className='entry';let last=c.history?.[0];d.innerHTML=`<div class="row">${c.portrait?`<img class="photo" src="${c.portrait}">`:'<div class="photo" style="display:grid;place-items:center">👤</div>'}<div><b>${esc(c.name)}</b><div class="muted">${esc(c.phone)}</div><span class="pill">${(c.history||[]).length} lượt dịch vụ</span></div></div><p class="muted">${last?esc(last.service)+' · '+fmt(last.price)+' · '+last.date:'Chưa có dịch vụ'}</p><div class="actions"><button class="soft" onclick="detail('${c.id}')">Lịch sử</button><button class="soft" onclick="edit('${c.id}')">Sửa</button><button class="red" onclick="removeC('${c.id}')">Xóa</button></div>`;el.appendChild(d)})}
function fmt(n){return (+n||0).toLocaleString('vi-VN')+'đ'}
async function detail(id){let c=(await all()).find(x=>x.id===id);let history=(c.history||[]).map(h=>`<article style="padding:10px;border-bottom:1px solid #ddd"><b>${esc(h.service)}</b><p>${esc(h.date)} · ${fmt(h.price)}</p><p>Sản phẩm: ${esc(h.product)}</p><p>Công thức: ${esc(h.formula)}</p><p>Thời gian: ${esc(h.timing)}</p><p>${esc(h.note)}</p>${(h.photos||[]).map(p=>`<img src="${p}" style="width:90px;border-radius:8px;margin:3px">`).join('')}</article>`).join('');let w=window.open('','_blank');if(!w)return alert('Trình duyệt chặn cửa sổ chi tiết. Hãy cho phép mở cửa sổ.');w.document.write(`<meta name="viewport" content="width=device-width,initial-scale=1"><body style="font:15px sans-serif;padding:16px"><h2>${esc(c.name)}</h2><p>${esc(c.phone)}</p><p>Tình trạng tóc: ${esc(c.hair)}</p><p>Lưu ý: ${esc(c.caution)}</p><h3>Lịch sử dịch vụ</h3>${history||'Chưa có lịch sử'}</body>`)}
async function edit(id){let c=(await all()).find(x=>x.id===id);clearForm();document.getElementById('cid').value=c.id;['name','phone','hair','caution'].forEach(k=>document.getElementById(k).value=c[k]||'');document.getElementById('formHeading').textContent='Cập nhật khách hàng';go('form')}
async function removeC(id){if(confirm('Xóa khách hàng này?')){let t=db.transaction(STORE,'readwrite');t.objectStore(STORE).delete(id);t.oncomplete=()=>{renderList();home()}}}
async function backup(){let data={app:'Salon Manager',version:2,created:new Date().toISOString(),customers:await all()},blob=new Blob([JSON.stringify(data)],{type:'application/json'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='SalonManager_Backup_'+new Date().toISOString().slice(0,10)+'.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)}
async function restoreData(e){let f=e.target.files[0];if(!f)return;try{let d=JSON.parse(await f.text());if(!Array.isArray(d.customers))throw 0;if(!confirm('Nhập dữ liệu và ghi đè hồ sơ trùng mã?'))return;for(let c of d.customers)await put(c);alert('Đã khôi phục.');home();renderList()}catch(x){alert('Tệp sao lưu không hợp lệ.')}e.target.value=''}
async function home(){let a=await all(),h=a.flatMap(c=>c.history||[]),today=new Date().toISOString().slice(0,10),up=h.filter(x=>x.visit&&x.visit>=today).sort((x,y)=>x.visit.localeCompare(y.visit));document.getElementById('nCust').textContent=a.length;document.getElementById('nServ').textContent=h.length;document.getElementById('nRev').textContent=fmt(h.reduce((s,x)=>s+(+x.price||0),0));document.getElementById('nVisit').textContent=up.length;document.getElementById('upcoming').innerHTML=up.length?up.slice(0,6).map(x=>`<div style="padding:6px 0;border-bottom:1px solid #eee">${esc(x.visit)} · ${esc(x.service||'Chăm sóc khách')}</div>`).join(''):'Chưa có lịch hẹn.'}
(async()=>{await openDB();await home()})();if('serviceWorker'in navigator)addEventListener('load',()=>navigator.serviceWorker.register('./sw.js').catch(()=>{}));
</script></body></html>
